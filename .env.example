# Copie este arquivo para .env e preencha. NUNCA suba o .env para o Git.

# Directory (tenant) ID, no formato GUID (Entra > App registrations > seu app > Overview)
TENANT_ID=00000000-0000-0000-0000-000000000000

# Application (client) ID (mesma tela)
CLIENT_ID=00000000-0000-0000-0000-000000000000

# VALOR do client secret (Certificates & secrets > New client secret). Aparece uma vez so.
CLIENT_SECRET=

# Chave que assina o cookie de sessao do Flask. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Precisa ser IDENTICO ao Redirect URI cadastrado no Entra (tipo Web)
REDIRECT_URI=http://localhost:5000/auth/callback

# Para onde o usuario volta depois do logout. Tambem precisa estar cadastrado no Entra.
POST_LOGOUT_REDIRECT_URI=http://localhost:5000/
